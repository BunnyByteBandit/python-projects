# Function to handle the voting system
def voting_system():
    print("Welcome to the voting system!")
    
    # Ask the user for their age
    age = input("Enter your age: ")

    try:
        age = int(age)  # Convert input to integer
        
        if age < 18:
            print("Sorry, you are not eligible to vote.")  # Not eligible if under 18
        else:
            # Display the candidates
            print("Candidates available to vote for:")
            print("1. Candidate A")
            print("2. Candidate B")
            print("3. Candidate C")
            
            # Ask the user to choose a candidate
            vote = input("Enter the number of the candidate you want to vote for (1, 2, or 3): ")
            
            if vote == "1":
                print("You voted for Candidate A!")
            elif vote == "2":
                print("You voted for Candidate B!")
            elif vote == "3":
                print("You voted for Candidate C!")
            else:
                print("Invalid choice. Please enter a number between 1 and 3.")  # Handle invalid vote input

    except ValueError:
        print("Please enter a valid number for age!")  # Handle non-numeric input for age

if __name__ == "__main__":
    voting_system()  # Start the voting process
