# Function to check the strength of the password
def pass_check():
    # Ask the user to enter their password
    pw = input("Type your password to check: ")

    # Check if the password is too short (less than 8 characters)
    if len(pw) < 8:
        print("Too short, need 8 or more characters.")  # Inform user about password length
    else:
        # Check if the password contains at least one lowercase letter
        if not any(c.islower() for c in pw):
            print("Need at least one lowercase letter.")  # Inform user to include lowercase
        # Check if the password contains at least one uppercase letter
        elif not any(c.isupper() for c in pw):
            print("Need at least one uppercase letter.")  # Inform user to include uppercase
        # Check if the password contains at least one number
        elif not any(c.isdigit() for c in pw):
            print("Need at least one number.")  # Inform user to include a number
        # Check if the password contains at least one special character
        elif not any(c in "!@#$%^&*()_+" for c in pw):
            print("Need at least one special char.")  # Inform user to include special char
        else:
            # If all conditions are satisfied, password is strong
            print("Strong password!")  # Inform user that password is strong

# Run the password checker function
if __name__ == "__main__":
    pass_check()  # Start the password check
