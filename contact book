# Dictionary to store contacts
contacts = {}

# Function to add a contact
def add_contact():
    print("Add a new contact: ")  # Tell the user they are adding a contact
    name = input("Enter contact name: ")  # Ask for name
    phone = input("Enter phone number: ")  # Ask for phone number
    contacts[name] = phone  # Save the contact in dictionary
    print(f"Contact for {name} added!")  # Confirm the addition

# Function to view all contacts
def view_contacts():
    if len(contacts) == 0:  # If there are no contacts
        print("No contacts available.")  # Tell the user there's no contacts
    else:
        for name, phone in contacts.items():  # Loop through all contacts
            print(f"Name: {name}, Phone: {phone}")  # Display each contact

# Function to remove a contact
def remove_contact():
    name = input("Enter the name of the contact to remove: ")  # Ask for the contact's name
    if name in contacts:  # If the contact exists in the dictionary
        del contacts[name]  # Delete the contact
        print(f"Contact for {name} removed!")  # Confirm removal
    else:
        print("Contact not found.")  # If the contact is not in the dictionary

# Main menu of the contact book app
def contact_book():
    while True:  # Start an infinite loop
        print("\nContact Book Menu:")  # Display menu
        print("1. View Contacts")  # Option 1 to view contacts
        print("2. Add Contact")  # Option 2 to add a new contact
        print("3. Remove Contact")  # Option 3 to remove a contact
        print("4. Exit")  # Option 4 to exit the app
        
        choice = input("Choose an option (1-4): ")  # Ask the user for their choice
        
        if choice == '1':  # If the user chooses to view contacts
            view_contacts()  # Call the view_contacts function
        elif choice == '2':  # If the user chooses to add a contact
            add_contact()  # Call the add_contact function
        elif choice == '3':  # If the user chooses to remove a contact
            remove_contact()  # Call the remove_contact function
        elif choice == '4':  # If the user chooses to exit
            print("Goodbye!")  # Say goodbye
            break  # Exit the loop and end the program
        else:  # If the user enters an invalid option
            print("Invalid option! Please choose again.")  # Let the user know it’s invalid

# Start the contact book program
if __name__ == "__main__":  # If this script is being run
    contact_book()  # Call the contact_book function to run the app
